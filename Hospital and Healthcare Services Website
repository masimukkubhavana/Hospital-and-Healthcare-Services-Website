
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>City Care Hospital</title>

<style>

/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f9fc;
    color: #333;
}

/* Header */
header {
    background: #087e8b;
    color: white;
    padding: 20px;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 20px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    transition: 0.3s;
}

nav ul li a:hover {
    color: #ffd166;
}

/* Home Section */
.home {
    min-height: 75vh;
    background: linear-gradient(135deg, #087e8b, #00b4d8);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
    animation: fadeIn 2s;
}

.home h1 {
    font-size: 42px;
    margin-bottom: 15px;
}

.home p {
    font-size: 18px;
    margin: 15px;
}

/* Buttons */
.btn {
    display: inline-block;
    background: #ffd166;
    color: #222;
    padding: 12px 25px;
    border-radius: 25px;
    text-decoration: none;
    margin-top: 15px;
    transition: 0.3s;
}

.btn:hover {
    background: white;
    transform: scale(1.05);
}

/* Sections */
section {
    padding: 50px 8%;
    text-align: center;
}

section h2 {
    color: #087e8b;
    margin-bottom: 25px;
    font-size: 30px;
}

/* Cards */
.container {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    width: 250px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
}

.card h3 {
    color: #087e8b;
    margin-bottom: 12px;
}

/* Visiting Hours */
table {
    width: 100%;
    max-width: 600px;
    margin: auto;
    border-collapse: collapse;
    background: white;
}

th, td {
    border: 1px solid #ccc;
    padding: 15px;
    text-align: center;
}

th {
    background: #087e8b;
    color: white;
}

/* Emergency Section */
.emergency {
    background: #ffe5e5;
    padding: 35px;
    border-radius: 10px;
}

.emergency h2 {
    color: red;
}

/* Appointment Form */
form {
    max-width: 500px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    text-align: left;
}

label {
    display: block;
    margin: 12px 0 6px;
    font-weight: bold;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #aaa;
    border-radius: 6px;
    font-size: 15px;
}

input:focus, select:focus, textarea:focus {
    outline: 2px solid #087e8b;
}

button {
    width: 100%;
    background: #087e8b;
    color: white;
    padding: 13px;
    border: none;
    border-radius: 6px;
    margin-top: 18px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background: #055b65;
}

/* Animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Footer */
footer {
    background: #087e8b;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Responsive Design */
@media(max-width: 768px) {
    nav {
        flex-direction: column;
        gap: 15px;
    }

    nav ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .home h1 {
        font-size: 30px;
    }

    section {
        padding: 35px 5%;
    }
}

@media(max-width: 480px) {
    nav ul li a {
        font-size: 13px;
    }

    .home h1 {
        font-size: 25px;
    }

    .card {
        width: 100%;
    }
}

</style>
</head>

<body>

<!-- Header -->
<header>
<nav>
<h2>City Care Hospital</h2>
<ul>
<li><a href="#home">Home</a></li>
<li><a href="#departments">Departments</a></li>
<li><a href="#doctors">Doctors</a></li>
<li><a href="#facilities">Facilities</a></li>
<li><a href="#appointment">Appointment</a></li>
<li><a href="#contact">Contact</a></li>
</ul>
</nav>
</header>

<!-- Home -->
<section class="home" id="home">
<div>
<h1>Welcome to City Care Hospital</h1>
<p>Your Health Is Our First Priority</p>
<p>Providing Quality Healthcare Services for Everyone.</p>
<a href="#appointment" class="btn">Book Appointment</a>
</div>
</section>

<!-- Departments -->
<section id="departments">
<h2>Our Departments</h2>
<div class="container">
<div class="card">
<h3>Cardiology</h3>
<p>Heart care and treatment services.</p>
</div>
<div class="card">
<h3>Neurology</h3>
<p>Diagnosis and treatment of brain disorders.</p>
</div>
<div class="card">
<h3>Orthopedics</h3>
<p>Bone and joint treatment services.</p>
</div>
<div class="card">
<h3>Pediatrics</h3>
<p>Healthcare services for children.</p>
</div>
</div>
</section>

<!-- Doctors -->
<section id="doctors">
<h2>Our Doctors</h2>
<div class="container">
<div class="card">
<h3>Dr. Ravi Kumar</h3>
<p>Cardiologist</p>
<p>Experience: 10 Years</p>
</div>
<div class="card">
<h3>Dr. Priya Sharma</h3>
<p>Neurologist</p>
<p>Experience: 8 Years</p>
</div>
<div class="card">
<h3>Dr. Arun Kumar</h3>
<p>Orthopedic Specialist</p>
<p>Experience: 7 Years</p>
</div>
</div>
</section>

<!-- Specialties -->
<section id="specialties">
<h2>Our Specialties</h2>
<div class="container">
<div class="card">
<h3>Heart Surgery</h3>
<p>Advanced heart treatment services.</p>
</div>
<div class="card">
<h3>Child Care</h3>
<p>Special care for newborns and children.</p>
</div>
<div class="card">
<h3>Emergency Care</h3>
<p>24/7 emergency medical support.</p>
</div>
</div>
</section>

<!-- Facilities -->
<section id="facilities">
<h2>Hospital Facilities</h2>
<div class="container">
<div class="card">
<h3>ICU</h3>
<p>Intensive care unit facilities.</p>
</div>
<div class="card">
<h3>Laboratory</h3>
<p>Modern medical testing facilities.</p>
</div>
<div class="card">
<h3>Ambulance</h3>
<p>Emergency ambulance services.</p>
</div>
<div class="card">
<h3>Pharmacy</h3>
<p>Medical store available in hospital.</p>
</div>
</div>
</section>

<!-- Visiting Hours -->
<section id="hours">
<h2>Visiting Hours</h2>
<table>
<tr>
<th>Day</th>
<th>Morning</th>
<th>Evening</th>
</tr>
<tr>
<td>Monday - Friday</td>
<td>10 AM - 12 PM</td>
<td>4 PM - 7 PM</td>
</tr>
<tr>
<td>Saturday</td>
<td>10 AM - 1 PM</td>
<td>4 PM - 6 PM</td>
</tr>
<tr>
<td>Sunday</td>
<td colspan="2">Closed for regular visits</td>
</tr>
</table>
<p>Emergency services are available 24/7.</p>
</section>

<!-- Appointment -->
<section id="appointment">
<h2>Book an Appointment</h2>

<form action="#" method="post">

<label for="name">Patient Name</label>
<input type="text" id="name" name="name"
placeholder="Enter your name" required>

<label for="email">Email Address</label>
<input type="email" id="email" name="email"
placeholder="Enter your email" required>

<label for="phone">Phone Number</label>
<input type="tel" id="phone" name="phone"
placeholder="Enter phone number" required>

<label for="department">Select Department</label>
<select id="department" name="department" required>
<option value="">Choose Department</option>
<option>Cardiology</option>
<option>Neurology</option>
<option>Orthopedics</option>
<option>Pediatrics</option>
</select>

<label for="date">Appointment Date</label>
<input type="date" id="date" name="date" required>

<label for="message">Message</label>
<textarea id="message" name="message"
rows="4" placeholder="Enter your message"></textarea>

<button type="submit">Submit Appointment</button>

</form>
</section>

<!-- Emergency Contact -->
<section id="contact">
<div class="emergency">
<h2>Emergency Contact</h2>
<h3>Emergency Number: 108</h3>
<p>Hospital Contact: +91 9876543210</p>
<p>Email: citycare@gmail.com</p>
<p>Address: Main Road, Andhra Pradesh, India</p>
</div>
</section>

<!-- Footer -->
<footer>
<p>© 2026 City Care Hospital. All Rights Reserved.</p>
<p>Care | Service | Health</p>
</footer>

</body>
</html>
